{
  "description": "Send privacy-conscious Codex turn attribution to Vantage.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/hooks/run_vantage_codex_hook.sh\"",
            "commandWindows": "python \"${PLUGIN_ROOT}\\hooks\\vantage_codex_hook.py\"",
            "timeout": 30,
            "statusMessage": "Loading Vantage attribution"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/hooks/run_vantage_codex_hook.sh\"",
            "commandWindows": "python \"${PLUGIN_ROOT}\\hooks\\vantage_codex_hook.py\"",
            "timeout": 30,
            "async": true,
            "statusMessage": "Adding Vantage usage tags"
          }
        ]
      }
    ]
  }
}
